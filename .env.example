# Copy to .env. Generate a unique password: python -c "import secrets; print(secrets.token_hex(24))"
# Use hex characters to avoid URL escaping in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-48-character-hex-password
# true when serving over HTTPS; false only for localhost HTTP
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Exact trusted hostnames, comma-separated; no scheme or path. Blank disables LMS requests.
# Example: university.instructure.com,moodle.university.edu
LMS_ALLOWED_HOSTS=
